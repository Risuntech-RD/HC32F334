            "overrideGDBServerStartedRegex": "GDB server (started|listening) (at|on) port",
            // "overrideLaunchCommands": [
            //     "target-download"
            // ],
            // "overrideResetCommands": [
            //     "interpreter-exec console \"interrupt\"",
            //     "target-download"
            // ],
            "runToEntryPoint": "main",
            "preLaunchTask": "kill-pyocd",
            "svdFile": "${workspaceFolder}/.pack/HDSC/HC32F334.1.0.0/SVD/HC32F334JATI.svd",
            "showDevDebugOutput": "raw"
        }
    ]
